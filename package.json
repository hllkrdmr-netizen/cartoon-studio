{
  "name": "cartoon-studio",
  "productName": "Cartoon Studio",
  "version": "0.1.0",
  "description": "An open-source desktop studio for making 2D animated cartoon shows. Write a script, pick voices, place characters, render to MP4.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "rig": "npx -y tsx --env-file=.env scripts/rig-svg.ts",
    "setup:chrome": "node -e \"require('fs').existsSync('./resources/chrome/chrome-headless-shell') || require('child_process').execSync('npx -y @puppeteer/browsers install chrome-headless-shell@stable --path ./resources/chrome', { stdio: 'inherit' })\"",
    "postinstall": "npm run setup:chrome"
  },
  "keywords": [],
  "author": {
    "name": "btpod",
    "email": "bilal@jellypod.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@puppeteer/browsers": "^2.13.0",
    "@tailwindcss/vite": "^4.2.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "41.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "hyperframes": "^0.4.11",
    "moveable": "^0.53.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@preact/signals-core": "^1.14.1",
    "@speech-sdk/core": "^0.6.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "openai": "^6.34.0",
    "zod": "^4.3.6"
  }
}
